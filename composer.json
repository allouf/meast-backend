{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "elasticsearch/elasticsearch": "8.0",
        "google/auth": "^1.47",
        "guzzlehttp/guzzle": "^7.10",
        "jerome/filterable": "^1.1",
        "kalnoy/nestedset": "^6.0",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.23",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "3.0",
        "maatwebsite/excel": "^3.1",
        "nwidart/laravel-modules": "^12.0",
        "opcodesio/log-viewer": "^3.21",
        "php-open-source-saver/jwt-auth": "^2.8",
        "predis/predis": "^3.3",
        "pusher/pusher-php-server": "^7.2",
        "spatie/laravel-permission": "^6.21",
        "spatie/laravel-translatable": "^6.11",
        "stripe/stripe-php": "^20.1",
        "twilio/sdk": "^8.8"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Advertisement\\": "Modules/Advertisement/app/",
            "Modules\\Advertisement\\Database\\Seeders\\": "Modules/Advertisement/database/seeders/",
            "Modules\\Job\\": "Modules/Job/app/",
            "Modules\\Job\\Database\\Seeders\\": "Modules/Job/database/seeders/",
            "Modules\\Store\\": "Modules/Store/app/",
            "Modules\\Store\\Database\\Seeders\\": "Modules/Store/database/seeders/",
            "Modules\\Community\\": "Modules/Community/app/",
            "Modules\\Core\\": "Modules/Core/app/",
            "Modules\\Core\\Database\\Seeders\\": "Modules/Core/database/seeders/",
            "Modules\\Services\\": "Modules/Services/app/",
            "Modules\\Services\\Database\\Seeders\\": "Modules/Services/database/seeders/",
            "Modules\\Ai\\": "Modules/Ai/app/",
            "Modules\\Wallet\\": "Modules/Wallet/app/",
            "Modules\\Wallet\\Database\\Seeders\\": "Modules/Wallet/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --ansi"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "11.x-dev"
        },
        "laravel": {
            "dont-discover": ["spatie/laravel-activitylog"]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
